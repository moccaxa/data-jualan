# Salin ke .env untuk pengembangan lokal. JANGAN commit file .env. Di Netlify isi lewat Site settings > Environment variables.

# --- Autentikasi admin ---
# Buat dengan: npm run hash-password -- "password-anda"
ADMIN_PASSWORD_HASH=
# Alternatif sederhana (tanpa terminal), min. 12 karakter. Dipakai HANYA jika ADMIN_PASSWORD_HASH kosong. Hash lebih disarankan.
ADMIN_PASSWORD=
# Buat dengan: npm run gen-secrets  (SESSION_SECRET minimal 32 karakter)
SESSION_SECRET=

# --- Enkripsi password akun jualan (AES-256-GCM, 32 byte base64) ---
# Buat dengan: npm run gen-secrets. JANGAN hilangkan/ganti: data terenkripsi tidak bisa dibuka tanpa kunci ini.
DATA_ENC_KEY=

# --- Google Sheets (service account) ---
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Salin nilai "private_key" dari file JSON; boleh dalam satu baris dengan \n literal
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=

# --- Telegram (Tahap 6) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Pemicu eksternal opsional untuk reminder (cron-job.org / GitHub Actions). Kosong = endpoint nonaktif. Minimal 24 karakter acak. ---
CRON_SECRET=
